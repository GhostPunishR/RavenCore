{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RavenEmu GB/GBC conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source", "license", "redistribution"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1, "maxLength": 256 },
        "redistribution": { "enum": ["external-only", "redistributable"] }
      }
    },
    "number": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^(?:0[xX][0-9A-Fa-f]+|[0-9]+)$" }
      ]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "value"],
      "properties": {
        "address": { "$ref": "#/$defs/number" },
        "value": { "$ref": "#/$defs/number" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pass": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "fail": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "register_signature": { "type": "boolean" },
        "memory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/memory" }
        },
        "framebuffer": { "$ref": "#/$defs/artifact" },
        "framebuffer_sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "minimum_pass_frames": { "type": "integer", "minimum": 0 },
        "memory_stability_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "anyOf": [
        {
          "required": ["serial"],
          "properties": { "serial": { "required": ["pass"] } }
        },
        {
          "required": ["register_signature"],
          "properties": { "register_signature": { "const": true } }
        },
        { "required": ["memory"] },
        { "required": ["framebuffer"] },
        { "required": ["framebuffer_sha256"] }
      ],
      "allOf": [
        {
          "if": { "required": ["memory"] },
          "then": {
            "required": ["memory_stability_samples"],
            "properties": { "memory_stability_samples": { "minimum": 2 } }
          }
        },
        {
          "not": { "required": ["framebuffer", "framebuffer_sha256"] }
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "hardware", "rom", "timeout_frames", "success"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "category": {
          "enum": [
            "cpu", "timing", "interrupts", "timer", "halt", "ei", "stop",
            "memory", "oam-dma", "vram-dma", "ppu", "stat", "palettes",
            "speed-switch", "serial", "apu", "mbc"
          ]
        },
        "hardware": { "enum": ["auto", "dmg", "cgb"] },
        "rom": { "$ref": "#/$defs/artifact" },
        "boot_rom": { "$ref": "#/$defs/artifact" },
        "timeout_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "success": { "$ref": "#/$defs/success" }
      }
    }
  }
}
